{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler"
    ,"ignoreDeprecations": "6.0"
    ,"baseUrl": "."
    ,"paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*","types/**/*", "vite.config.ts"]
}
